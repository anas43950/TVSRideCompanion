<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer: an orange sport-bike silhouette, centred.

  An original drawing. Only the colour scheme (orange on white) follows the
  official TVS Connect icon; none of its artwork is used.

  Adaptive icons are 108x108 and only a 66-unit circle around the centre is
  guaranteed visible under every mask; the scaled bike stays inside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawn on the full 108 grid (bounds x 14..93.5, y 35..86.5) and
         scaled by 0.74 about its centre onto the icon centre (54,54). -->
    <group
        android:scaleX="0.74"
        android:scaleY="0.74"
        android:translateX="14.225"
        android:translateY="9.045">
        <!-- Wheels. -->
        <path android:pathData="M19.5,72 a11.5,11.5 0 1,0 23.0,0 a11.5,11.5 0 1,0 -23.0,0" android:strokeColor="#FFE04426" android:strokeWidth="6" />
        <path android:pathData="M67.5,72 a11.5,11.5 0 1,0 23.0,0 a11.5,11.5 0 1,0 -23.0,0" android:strokeColor="#FFE04426" android:strokeWidth="6" />
        <!-- Swingarm and fork. -->
        <path android:pathData="M46,62 L31,72" android:strokeColor="#FFE04426" android:strokeWidth="5.5" android:strokeLineCap="round" />
        <path android:pathData="M73,50 L79,72" android:strokeColor="#FFE04426" android:strokeWidth="5.5" android:strokeLineCap="round" />
        <!-- Tail, seat, tank and fairing in one shape. -->
        <path android:pathData="M14,46 C22,47 30,49 38,50 C42,46 48,43 56,42 L64,42 C67,39 70,36 74,35 L77,35 C81,39 84,44 84,49 L77,53 C73,57 68,61 60,64 L46,64 C42,60 36,56 14,46 Z" android:fillColor="#FFE04426" />
        <!-- Seat line and windscreen edge, cut in the background colour. -->
        <path android:pathData="M24,48.5 L37,50" android:strokeColor="#FFFFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round" />
        <path android:pathData="M65,43 C68,40 71,38 75,37.5" android:strokeColor="#FFFFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round" />
        <!-- Hubs. -->
        <path android:pathData="M28,72 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" android:fillColor="#FFE04426" />
        <path android:pathData="M76,72 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" android:fillColor="#FFE04426" />
    </group>
</vector>
