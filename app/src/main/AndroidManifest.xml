<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE to the cluster -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BLE scanning needs location on Android 11 and below. On 12+ the
         neverForLocation flag on BLUETOOTH_SCAN covers it, so this is dropped
         there (maxSdkVersion 30) and never appears on a modern phone. The app
         reads no location of its own. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- No INTERNET permission, on purpose. The app speaks only to the
         cluster over BLE; nothing it holds (rides, contacts, call log) has
         a way off the phone except a file the rider shares from More. -->

    <!-- Read navigation from any maps app -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" xmlns:tools="http://schemas.android.com/tools" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Permissions mirrored from the working Jupiter companion app
      (com.tvs.jupiter, CC BY-NC 4.0 — see research/SOURCES.md), each with the
      reason it is wanted here.
    -->
    <!-- Doze parks the GATT connection within minutes and the cluster drops the
         link when the presence packet stops. Without this exemption a ride dies
         the moment the screen goes off, which is most of a ride. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reconnect after a reboot or power cut. The cluster keeps advertising;
         nothing re-attaches without this. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Discovers which navigation app is actually installed, so mirroring is
         not limited to a hardcoded package list. Read-only; sees no app data. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Caller ID on the cluster. TVS's Ntorq 125 manual lists "CALLER ID and
         SMS notification on speedometer" as a documented feature of the
         connected cluster, with a green smart-connect LED for an incoming call
         or message, so this is now requested rather than scoped out.

         READ_PHONE_STATE  - the phone is ringing / in a call
         READ_CALL_LOG     - missed calls, which the cluster shows like an SMS
         READ_CONTACTS     - resolve a number to a name for the display

         What the data can do: nothing beyond the phone. The app has no
         INTERNET permission, so there is nowhere to send it. The only
         consumers are the caller-ID formatter (renders as bytes on the
         cluster) and the on-device contact resolver.

         Call reply (the Apache's handlebar end-call button), asked for from
         the More screen and the first-run prompt:
         ANSWER_PHONE_CALLS - end the ringing call (TelecomManager.endCall).
                              A normal runtime permission since Android 8;
                              an earlier note here wrongly called it
                              default-dialer only.
         SEND_SMS           - text the reply to the caller, contacts only.
                              Sent through the SIM; never the call log or
                              contacts themselves.

         NOT requested: CALL_PHONE. Answering a call from the cluster is not
         needed; the button only ends calls. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- No TVS contact, enforced by the build rather than by audit. Without
         INTERNET the app cannot reach any server: no account, no
         registration, no SmartXonnect backend calls, no telemetry upload.
         CI asserts the permission stays absent from the merged manifest. -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Auto-connect. Companion Device Manager watches for the saved vehicle and
         wakes VehiclePresenceService when it appears, even with the app closed,
         and is what allows starting the connectedDevice foreground service from
         the background. All three are normal (install-time) permissions; the
         rider still consents once, in the system association dialog. Not
         required: below Android 12 the app falls back to a background connect. -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <!-- SEND_SMS and ANSWER_PHONE_CALLS would otherwise make telephony required. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!-- Android Auto Backup: the OS copies the ride history and settings to the
         rider's own Google Drive, and restores them on a reinstall or a new
         phone. No INTERNET permission is involved — the system backup transport
         does the upload, not the app, so "no account, no cloud" still holds.
         The rules allowlist the rides DB and the shared prefs and leave the
         frame log (street names, cluster MAC) off Drive. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVSRide">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".transport.RideService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Bound by the system when the associated vehicle comes into range
             (Android 12+). See VehiclePresenceService. -->
        <service
            android:name=".transport.VehiclePresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- Re-attach after reboot when auto-connect is on; see BootReceiver. -->
        <receiver
            android:name=".transport.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lends the data export file to the app the rider shares it with,
             read-only and only for that share. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- The whole point: read turn-by-turn from Google Maps or any other
             maps app without an account anywhere. -->
        <service
            android:name=".nav.MapsNotificationListener"
            android:exported="true"
            android:label="TVSRide navigation"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>